
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>بوابة ولي الأمر - مدرسة الضياء للبنات</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
    <style> body { font-family: 'Cairo', sans-serif; } </style>
</head>
<body class="bg-pink-50 text-gray-800 min-h-screen p-6">

    <div class="max-w-4xl mx-auto space-y-6">
        
        <!-- رأس الصفحة الخاص بولي الأمر فقط -->
        <div class="bg-white p-4 rounded-xl shadow-sm border border-pink-100 flex justify-between items-center">
            <div>
                <h1 class="text-base font-bold text-pink-700">مدرسة الضياء للبنات 🌸</h1>
                <div class="flex flex-col text-xs text-gray-500 font-semibold gap-0.5 mt-1">
                    <span id="displayPrincipalName">مديرة المدرسة: د. أمل عبد الله</span>
                    <span id="displaySupervisorName" class="text-pink-600">مشرف المنصة: الأستاذ أحمد علي</span>
                </div>
            </div>
            <span class="text-xs font-bold text-pink-600 bg-pink-100 px-3 py-1 rounded-full">بوابة أولياء الأمور</span>
        </div>

        <!-- 1. نموذج طلب دخول ولي الأمر -->
        <div id="parentLoginView" class="bg-white p-8 rounded-2xl shadow-sm border border-pink-100 max-w-lg mx-auto space-y-4">
            <h2 class="text-xl font-bold text-pink-600 text-center mb-1">بوابة ولي الأمر - مدرسة الضياء</h2>
            <p class="text-xs text-gray-500 text-center mb-4">أدخل بيانات الطّالبة للوصول إلى التنبيهات المخصصة لصفها</p>
            
            <div>
                <label class="block text-sm font-semibold mb-1">اسم الطّالبة الثلاثي:</label>
                <input type="text" id="pStudentName" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-pink-400 focus:outline-none" placeholder="مثال: فاطمة علي حسن">
            </div>
            <div>
                <label class="block text-sm font-semibold mb-1">اسم الأم الثلاثي:</label>
                <input type="text" id="pMotherName" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-pink-400 focus:outline-none" placeholder="اسم الأم الثلاثي">
            </div>
            <div class="grid grid-cols-3 gap-2">
                <div>
                    <label class="block text-sm font-semibold mb-1">المرحلة:</label>
                    <select id="pStage" class="w-full px-3 py-2 border rounded-lg bg-white">
                        <option value="الابتدائية">الابتدائية</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-semibold mb-1">الصف:</label>
                    <select id="pGrade" class="w-full px-3 py-2 border rounded-lg bg-white">
                        <option value="الأول الابتدائي">الأول الابتدائي</option>
                        <option value="الثاني الابتدائي">الثاني الابتدائي</option>
                        <option value="الثالث الابتدائي">الثالث الابتدائي</option>
                        <option value="الرابع الابتدائي">الرابع الابتدائي</option>
                        <option value="الخامس الابتدائي">الخامس الابتدائي</option>
                        <option value="السادس الابتدائي">السادس الابتدائي</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-semibold mb-1">الشعبة:</label>
                    <select id="pSection" class="w-full px-3 py-2 border rounded-lg bg-white">
                        <option value="أ">أ</option>
                        <option value="ب">ب</option>
                        <option value="ج">ج</option>
                    </select>
                </div>
            </div>

            <div id="loginMessage" class="text-center text-sm font-semibold hidden"></div>
            
            <button onclick="submitParentRequest()" class="w-full bg-pink-600 text-white py-2 rounded-lg font-semibold hover:bg-pink-700 transition mt-2">إرسال الطلب للإدارة</button>
        </div>

        <!-- 2. لوحة متابعة ولي الأمر (تفتح فقط عند الموافقة) -->
        <div id="parentDashboardView" class="hidden space-y-6">
            <div class="bg-white p-6 rounded-xl shadow-sm border border-pink-100 flex justify-between items-center">
                <div>
                    <h2 class="text-xl font-bold text-pink-800">مدرسة الضياء للبنات - بوابة المتابعة</h2>
                    <div id="sortedBadge" class="mt-1 inline-block bg-pink-100 text-pink-800 text-xs px-3 py-1 rounded-full font-bold"></div>
                </div>
                <button onclick="logoutParent()" class="bg-red-500 text-white px-3 py-1 rounded text-sm">تسجيل خروج</button>
            </div>

            <!-- صندوق مراسلة الإدارة -->
            <div class="bg-white p-6 rounded-xl shadow-sm border border-blue-200 space-y-3">
                <div class="flex justify-between items-center">
                    <h3 class="font-bold text-blue-900 text-sm">💬 إرسال رسالة أو استفسار للإدارة (نصية أو صوتية):</h3>
                    <span class="text-[10px] text-gray-400 font-light italic">ملاحظة: يمكنك إرسال رسالتين كحد أقصى خلال الأسبوع</span>
                </div>
                
                <div>
                    <label class="block text-xs font-semibold mb-1">نوع الرسالة:</label>
                    <select id="parentMsgType" onchange="toggleParentInputType()" class="w-full px-3 py-2 border rounded-lg bg-white text-xs">
                        <option value="text">رسالة نصية</option>
                        <option value="audio">رسالة صوتية (Voice Note)</option>
                    </select>
                </div>

                <div id="parentTextInputDiv">
                    <textarea id="parentInquiryText" rows="2" class="w-full px-3 py-2 border rounded-lg text-xs" placeholder="اكتب سؤالك أو استفسارك هنا..."></textarea>
                </div>

                <div id="parentAudioInputDiv" class="hidden">
                    <input type="text" id="parentAudioUrl" class="w-full px-3 py-2 border rounded-lg text-xs" placeholder="ضع رابط الملف الصوتي (MP3) هنا...">
                </div>

                <button onclick="sendParentInquiry()" class="bg-blue-600 text-white px-4 py-2 rounded-lg text-xs font-semibold hover:bg-blue-700">إرسال إلى الإدارة</button>
            </div>

            <!-- التنبيهات والرسائل الواردة للطالبة -->
            <div class="bg-white p-6 rounded-xl shadow-sm border border-pink-100 space-y-4">
                <h3 class="font-bold text-gray-700">📢 التنبيهات والرسائل الواردة الخاصة بالطّالبة:</h3>
                <div id="parentTargetedNotificationsList" class="space-y-3"></div>
            </div>
        </div>

    </div>

    <script>
        let principalName = localStorage.getItem('school_principal_name') || 'د. أمل عبد الله';
        let supervisorName = localStorage.getItem('school_supervisor_name') || 'الأستاذ أحمد علي';

        let pendingRequests = JSON.parse(localStorage.getItem('school_pending')) || [];
        let approvedStudents = JSON.parse(localStorage.getItem('school_approved')) || [];
        let parentInquiries = JSON.parse(localStorage.getItem('school_inquiries')) || [];
        let currentSessionStudent = JSON.parse(localStorage.getItem('school_current')) || null;

        window.onload = function() {
            document.getElementById('displayPrincipalName').textContent = `مديرة المدرسة: ${principalName}`;
            document.getElementById('displaySupervisorName').textContent = `مشرف المنصة: ${supervisorName}`;

            if (currentSessionStudent) {
                const stillApproved = approvedStudents.some(st => st.id === currentSessionStudent.id);
                if (stillApproved) {
                    currentSessionStudent = approvedStudents.find(st => st.id === currentSessionStudent.id);
                    document.getElementById('parentLoginView').classList.add('hidden');
                    document.getElementById('parentDashboardView').classList.remove('hidden');
                    updateParentDashboardUI(currentSessionStudent);
                } else {
                    logoutParent();
                }
            }
        };

        function saveData() {
            localStorage.setItem('school_pending', JSON.stringify(pendingRequests));
            localStorage.setItem('school_approved', JSON.stringify(approvedStudents));
            localStorage.setItem('school_inquiries', JSON.stringify(parentInquiries));
            localStorage.setItem('school_current', JSON.stringify(currentSessionStudent));
        }

        function submitParentRequest() {
            const sName = document.getElementById('pStudentName').value.trim();
            const mName = document.getElementById('pMotherName').value.trim();
            const stage = document.getElementById('pStage').value;
            const grade = document.getElementById('pGrade').value;
            const section = document.getElementById('pSection').value;
            const msg = document.getElementById('loginMessage');

            if (!sName || !mName) {
                msg.textContent = "❌ الرجاء إدخال اسم الطّالبة واسم الأم ثلاثياً!";
                msg.className = "text-center text-sm font-semibold text-red-500";
                msg.classList.remove('hidden');
                return;
            }

            const newReq = { 
                id: Date.now(), student: sName, mother: mName, stage, grade, section, weeklyInquiries: [], hasReceivedAutoReply: false,
                notifications: [{ type: 'text', title: "حالة الطلب", body: "⏳ تم إرسال الطلب بنجاح، بانتظار موافقة الإدارة..." }] 
            };
            
            pendingRequests.push(newReq);
            saveData();
            
            msg.textContent = "⏳ تم إرسال الطلب بنجاح، يرجى الانتظار لحين موافقة إدارة المدرسة لفتح البوابة...";
            msg.className = "text-center text-sm font-semibold text-pink-600";
            msg.classList.remove('hidden');
        }

        function toggleParentInputType() {
            const type = document.getElementById('parentMsgType').value;
            document.getElementById('parentTextInputDiv').classList.toggle('hidden', type !== 'text');
            document.getElementById('parentAudioInputDiv').classList.toggle('hidden', type === 'text');
        }

        function sendParentInquiry() {
            const msgType = document.getElementById('parentMsgType').value;
            let content = msgType === 'text' ? document.getElementById('parentInquiryText').value.trim() : document.getElementById('parentAudioUrl').value.trim();

            if (!content) { alert("الرجاء إدخال محتوى الرسالة أولاً."); return; }

            if (!currentSessionStudent.weeklyInquiries) currentSessionStudent.weeklyInquiries = [];
            const oneWeekAgo = Date.now() - (7 * 24 * 60 * 60 * 1000);
            currentSessionStudent.weeklyInquiries = currentSessionStudent.weeklyInquiries.filter(t => t > oneWeekAgo);

            if (currentSessionStudent.weeklyInquiries.length >= 2) {
                alert("عذراً، لقد وصلت إلى الحد الأقصى (رسالتان فقط أسبوعياً).");
                return;
            }

            const newInquiry = { id: Date.now(), studentId: currentSessionStudent.id, studentName: currentSessionStudent.student, stage: currentSessionStudent.stage, grade: currentSessionStudent.grade, section: currentSessionStudent.section, type: msgType, content: content };
            currentSessionStudent.weeklyInquiries.push(Date.now());
            parentInquiries.push(newInquiry);

            if (!currentSessionStudent.hasReceivedAutoReply) {
                currentSessionStudent.notifications.unshift({ type: 'text', title: '💬 رد آلي من إدارة المدرسة', body: 'شكراً لتعاونكم مع إدارة مدرسة الضياء الابتدائية للبنات، سوف نقوم بالرد عليكم بأقرب وقت ممكن.' });
                currentSessionStudent.hasReceivedAutoReply = true;
            }

            const stIndex = approvedStudents.findIndex(st => st.id === currentSessionStudent.id);
            if (stIndex !== -1) approvedStudents[stIndex] = currentSessionStudent;

            saveData();
            document.getElementById('parentInquiryText').value = '';
            document.getElementById('parentAudioUrl').value = '';
            alert("✓ تم إرسال الرسالة بنجاح للإدارة.");
            updateParentDashboardUI(currentSessionStudent);
        }

        function logoutParent() {
            if (confirm("هل أنت متأكد من تسجيل الخروج؟")) {
                currentSessionStudent = null;
                localStorage.removeItem('school_current');
                document.getElementById('parentDashboardView').classList.add('hidden');
                document.getElementById('parentLoginView').classList.remove('hidden');
            }
        }

        function updateParentDashboardUI(student) {
            document.getElementById('sortedBadge').textContent = `الطّالبة: ${student.student} (${student.grade} - شعبة ${student.section})`;
            const list = document.getElementById('parentTargetedNotificationsList');
            list.innerHTML = '';
            (student.notifications || []).forEach(n => {
                list.innerHTML += n.type === 'text' 
                    ? `<div class="p-4 bg-pink-50 border-r-4 border-pink-500 rounded-lg"><h4 class="font-bold text-pink-900">${n.title}</h4><p class="text-sm text-gray-700 mt-1">${n.body}</p></div>`
                    : `<div class="p-4 bg-pink-50 border-r-4 border-pink-600 rounded-lg space-y-2"><h4 class="font-bold text-pink-900">${n.title}</h4><audio controls class="w-full"><source src="${n.url}" type="audio/mpeg"></audio></div>`;
            });
        }
    </script>
</body>
</html>
